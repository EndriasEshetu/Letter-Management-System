# ─── Server ────────────────────────────────────────────────
# Must match the base URL the frontend already uses (api.ts default: http://localhost:5000/api)
PORT=5000

# Comma-separated list of allowed origins (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ─── Supabase ─────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Public "anon" key — used to verify user JWTs server-side
SUPABASE_ANON_KEY=

# Secret "service_role" key — used for admin auth ops + Storage
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string from Supabase dashboard
# (Settings → Database → Connection string → URI, transaction pooler port 6543)
# e.g. postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Storage bucket where document files are stored (created automatically by the seed script)
SUPABASE_STORAGE_BUCKET=documents
