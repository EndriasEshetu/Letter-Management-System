# ─── Server ──────────────────────────────────────────────
# Port the server listens on (Railway sets this automatically)
PORT=5000

# Comma-separated list of allowed origins (frontend dev server / production URL)
CORS_ORIGIN=http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────
# Connection string for your PostgreSQL database.
# Local example:  postgresql://postgres:password@localhost:5432/letter_management
# Railway:        Automatically provided as DATABASE_URL by the Railway Postgres plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/letter_management

# Set to "true" when connecting to Railway / any managed Postgres that requires SSL
DB_SSL=false

# ─── JWT Auth ─────────────────────────────────────────────
# Secret used to sign and verify JSON Web Tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# Token expiry (e.g. "7d", "24h", "3600")
JWT_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────
# Absolute or relative path where uploaded files are stored on disk.
# Railway: mount a Volume at /data/uploads and set this to /data/uploads
UPLOADS_DIR=./uploads
